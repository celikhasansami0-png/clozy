# Supabase — copy from your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Anthropic (@Bionova AI) — optional. Without a key the AI features run in demo mode.
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-opus-4-8). e.g. claude-sonnet-4-6
ANTHROPIC_MODEL=

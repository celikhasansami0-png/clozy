# ─────────────────────────────────────────────────────────────────────────────
# Scouting — environment variables
# Copy to .env.local (local dev) or set in Vercel project settings (production).
# The app runs fully in DEMO mode with NONE of these set; fill them in to go live.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Supabase (auth + persistence) ── REQUIRED for real data ──────────────────
# Without these, hooks fall back to in-memory demo data (lost on refresh).
# Setup: create a Supabase project, then run in the SQL editor — IN THIS ORDER:
#   1) supabase/schema.sql        (profiles + shared triggers)
#   2) supabase/scouting-schema.sql (leads, campaigns, messages, ... + RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── AI provider ── REQUIRED for live AI (else high-fidelity mock) ────────────
# Anthropic is the default. Without a key, services/ai.ts uses the MockProvider.
ANTHROPIC_API_KEY=
# Optional overrides:
ANTHROPIC_MODEL=claude-sonnet-4-6
# Force a provider: "anthropic" | "openai" | "mock" (auto-detected if unset)
AI_PROVIDER=
# OpenAI is supported as an alternative:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── Stripe (billing) ── REQUIRED only if you charge ─────────────────────────
# Create two recurring prices in Stripe (Starter $49, Growth $99) and paste IDs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_STUDENT_PRO_PRICE_ID=   # Starter plan price id
NEXT_PUBLIC_STRIPE_TEAM_PRO_PRICE_ID=      # Growth plan price id

# ─── Web push (optional, PWA notifications) ──────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
